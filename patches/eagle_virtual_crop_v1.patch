+# PIXEL_PIVR_VIRTUAL_CROP_V1
+def _pixel_pivr_virtual_crop(image_data, media_root):
+    """Materialize a validated Pixel-PIVR crop without storing duplicate images."""
+    source_path = image_data.get("path")
+    crop = image_data.get("crop_xyxy")
+    resize_hw = image_data.get("resize_hw")
+    schema = image_data.get("schema")
+    resample = str(image_data.get("resample", "")).lower()
+    if schema != "pixel-pivr-virtual-crop-v1":
+        raise ValueError(f"Unsupported virtual_crop schema: {schema!r}")
+    if not isinstance(source_path, str) or not source_path:
+        raise ValueError("virtual_crop image requires a non-empty 'path'")
+    if not osp.isabs(source_path):
+        source_path = osp.join(media_root, source_path)
+    if (
+        not isinstance(crop, list)
+        or len(crop) != 4
+        or any(isinstance(value, bool) or not isinstance(value, int) for value in crop)
+    ):
+        raise ValueError("virtual_crop requires integer crop_xyxy=[left, top, right, bottom]")
+    if (
+        not isinstance(resize_hw, list)
+        or len(resize_hw) != 2
+        or any(isinstance(value, bool) or not isinstance(value, int) or value <= 0 for value in resize_hw)
+    ):
+        raise ValueError("virtual_crop requires positive integer resize_hw=[height, width]")
+    if resample != "lanczos":
+        raise ValueError(f"Pixel-PIVR virtual_crop requires Lanczos, got {resample!r}")
+    left, top, right, bottom = crop
+    with Image.open(source_path) as source:
+        width, height = source.size
+        if not (0 <= left < right <= width and 0 <= top < bottom <= height):
+            raise ValueError(
+                f"virtual_crop is outside {source_path}: crop={crop}, image_size={(width, height)}"
+            )
+        local = source.convert("RGB").crop((left, top, right, bottom))
+        target_height, target_width = resize_hw
+        if local.size != (target_width, target_height):
+            local = local.resize((target_width, target_height), Image.Resampling.LANCZOS)
+        return local
+
