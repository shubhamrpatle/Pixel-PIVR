# Copy to configs/full_scale.env. Quote every path that contains spaces.
PYTHON_BIN="/absolute/path/to/Pixel-PIVR/.venv/bin/python"
MODEL_PATH="/absolute/path/to/LocateAnything-3B"
EAGLE_ROOT="/absolute/path/to/Eagle/Embodied"
DATA_ROOT="/absolute/path/to/Pixel-PIVR-data"
RUN_ROOT="/absolute/path/to/pixel-pivr-runs/full-scale-hbb"

# Any comma-separated set of 1, 2, or 4 free GPUs. GLOBAL_BATCH must be divisible
# by the number of GPUs and must remain unchanged when an interrupted run resumes.
GPU_IDS=0,1,2,3
GLOBAL_BATCH=4
SAMPLE_ORDER=shuffled

# Architecture used by the full-scale single-encode experiment.
VISUAL_CONTEXT=preprojector_magnified_roi
IMAGE_TOKEN_LIMIT=6000
MAX_SEQUENCE=8192
MAGNIFIED_ROI_PIXELS=380
MAGNIFIED_ROI_STRIDE=1
LORA_RANK=16

# One exact pass per stage. Padding is derived and recorded (2 rows in Stage 1,
# 3 rows in Stage 2 for GLOBAL_BATCH=4).
LEARNING_RATE=1e-5
WARMUP_STEPS_STAGE1=1000
WARMUP_STEPS_STAGE2=1000
CHECKPOINT_STEPS=500
EVAL_STEPS=500
VALIDATION_RECORDS=1000
VALIDATION_SAMPLING=stratified_files
WORKERS=4
SEED=20260901
VISION_ATTENTION=auto
SERIAL_MODEL_LOAD=1

# Optional W&B. Leave project empty to disable it.
WANDB_PROJECT=pixel-pivr
WANDB_NAME_PREFIX=pixel-pivr-full-scale

# Evaluation uses the selected Stage-2 adapter unless EVAL_ADAPTER is set.
EVAL_ADAPTER=
EVAL_GPU_IDS=0,1,2,3
EVAL_WAVE_SIZE=200
EVAL_PREFIX_CACHE_MODE=shared
EVAL_ALLOW_NONE=1
