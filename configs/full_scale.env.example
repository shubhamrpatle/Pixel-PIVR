# Pixel-PIVR full-scale contract for one 8 x A100 80GB node.
# Copy this file to configs/full_scale.env and edit only the absolute paths.
PYTHON_BIN="/absolute/path/to/Pixel-PIVR/.venv/bin/python"
MODEL_PATH="/absolute/path/to/pixel-pivr-assets/LocateAnything-3B"
EAGLE_ROOT="/absolute/path/to/pixel-pivr-assets/Eagle/Embodied"
DATA_ROOT="/absolute/path/to/pixel-pivr-assets/Pixel-PIVR-Magnified-v2"
RUN_ROOT="/absolute/path/to/pixel-pivr-runs/magnified-v2"

# Immutable release identities. The configuration helper fills CODE_REVISION
# from the checkout and requires DATA_REVISION from the verified Hub upload.
CODE_REVISION=REPLACE_WITH_40_CHARACTER_GIT_COMMIT
DATA_REVISION=REPLACE_WITH_40_CHARACTER_HF_COMMIT
MODEL_REVISION=c32291ca5e996f5a7a485845b4f57a233936bba0
EAGLE_REVISION=8442db3b79f7fd2357e468e6eecdd9b6a82049ff

# These two acknowledgements prevent an old/cached-ROI config from starting.
ARCHITECTURE_CONTRACT=pixel_crop_144to384_v2
FULL_SCALE_APPROVED=NO

# One model replica and one record per GPU per optimizer update. Global batch 8
# is the closest feasible 8-GPU scale-up of the validated global-batch-4 pilot.
# Do not change these values when resuming an existing stage.
GPU_IDS=0,1,2,3,4,5,6,7
REQUIRED_GPUS=8
REQUIRED_GPU_NAME=A100
MINIMUM_GPU_MEMORY_GIB=75
GLOBAL_BATCH=8
SAMPLE_ORDER=shuffled

# Final magnified architecture. The local view is declared in the dataset as a
# 144x144 source-pixel virtual crop resized to 384x384 before normal LA alignment.
VISUAL_CONTEXT=pixel_reencoded
SOURCE_CROP_SIDE=144
LOCAL_INPUT_SIDE=384
MAGNIFIED_ROI_PIXELS=384
IMAGE_TOKEN_LIMIT=6000
MAX_SEQUENCE=32768
LORA_RANK=16
# Visit every flattened record exactly once, but scale per-record loss so the
# aggregate task contribution preserves the source-query task mixture. Without
# this, address expansion makes Stage 2 approximately 97% detection by rows.
LOSS_BALANCING=source_query_task

# Stage 2 starts from Stage 1 best validation loss with a fresh optimizer.
LEARNING_RATE_STAGE1=1e-5
LEARNING_RATE_STAGE2=5e-6
WARMUP_STEPS_STAGE1=600
WARMUP_STEPS_STAGE2=1500
WEIGHT_DECAY=0.01
MAX_GRAD_NORM=1.0
CHECKPOINT_STEPS=1000
KEEP_RECENT_CHECKPOINTS=1
EVAL_STEPS=5000
LOG_STEPS=50
# Use every record in the fixed all-task monitor. Zero means no subsampling.
VALIDATION_RECORDS=0
VALIDATION_SAMPLING=first
WORKERS=4
SEED=20260904
VISION_ATTENTION=flash_attention_2
SERIAL_MODEL_LOAD=1

# Preflight checks the run filesystem before launch.
MINIMUM_RUN_FREE_GIB=100
VERIFY_IMAGE_HASHES=1
REQUIRE_FLASH_ATTN=1

# Optional W&B. Run `wandb login` first, or set WANDB_PROJECT= to disable it.
WANDB_PROJECT=pixel-pivr
WANDB_NAME_PREFIX=pixel-pivr-magnified-v2

# Evaluation uses Stage 2 best.pt unless EVAL_ADAPTER is explicitly set.
EVAL_ADAPTER=
EVAL_GPU_IDS=0,1,2,3,4,5,6,7
EVAL_WAVE_SIZE=200
EVAL_PREFIX_CACHE_MODE=shared
EVAL_CROP_SIDE=144
EVAL_LOCAL_RESIZE_SIDE=384
EVAL_GEOMETRY_PREFIX_MODE=box_only
EVAL_GLOBAL_FALLBACK=1
EVAL_FALLBACK_EDGE_MARGIN=2
EVAL_ALLOW_NONE=1
# Dense scenes can require thousands of point blocks. This is a generation
# budget, not a prediction cap; decoding normally stops earlier at EOS.
EVAL_POINT_MAX_NEW_TOKENS=24576
