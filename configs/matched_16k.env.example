# Exact matched 16K/4K mechanism-gate configuration.
PYTHON_BIN=/absolute/path/to/venv/bin/python
MODEL_PATH=/absolute/path/to/LocateAnything-3B
EAGLE_ROOT=/absolute/path/to/Eagle/Embodied
DATA_ROOT=/absolute/path/to/workspace/root
TRAIN_DATA=/absolute/path/to/pivr_lora_4k_v1/train.jsonl
VALIDATION_DATA=/absolute/path/to/pivr_lora_4k_v1/validation.jsonl
OUTPUT_DIR=/absolute/path/to/output/pixel_pivr_matched_16k
SMOKE_DIR=/absolute/path/to/output/pixel_pivr_smoke

GPU_IDS=0,1,2,3
GLOBAL_BATCH=4
MAX_STEPS=4000
ALLOWED_PADDING_RECORDS=0
VALIDATION_RECORDS=1000
LORA_RANK=16
IMAGE_TOKEN_LIMIT=1024
MAX_SEQUENCE=8192
LEARNING_RATE=1e-5
WARMUP_STEPS=100
CHECKPOINT_STEPS=500
EVAL_STEPS=500
WORKERS=2
SEED=20260901
VISION_ATTENTION=auto
SERIAL_MODEL_LOAD=1

# Leave blank to disable W&B.
WANDB_PROJECT=
WANDB_NAME=pixel-pivr-matched-16k
WANDB_RUN_ID=
INIT_ADAPTER=
