# Portable large-scale Pixel-PIVR HBB training configuration.
PYTHON_BIN=/absolute/path/to/venv/bin/python
MODEL_PATH=/absolute/path/to/LocateAnything-3B
EAGLE_ROOT=/absolute/path/to/Eagle/Embodied
DATA_ROOT=/absolute/path/to/workspace/root
TRAIN_DATA=/absolute/path/to/audited_pixel_pivr_hbb_train.jsonl
VALIDATION_DATA=/absolute/path/to/audited_pixel_pivr_hbb_validation.jsonl
OUTPUT_DIR=/absolute/path/to/checkpoints/pixel_pivr_large_scale_stage1
SMOKE_DIR=/absolute/path/to/checkpoints/pixel_pivr_large_scale_smoke

# The launcher keeps the effective record batch fixed when GPU count changes.
GPU_IDS=0,1,2,3
GLOBAL_BATCH=4

# Zero derives one exact pass from line count / GLOBAL_BATCH.
MAX_STEPS=0
ALLOWED_PADDING_RECORDS=0
VALIDATION_RECORDS=1000

LORA_RANK=16
IMAGE_TOKEN_LIMIT=1024
MAX_SEQUENCE=8192
LEARNING_RATE=1e-5
WARMUP_STEPS=500
CHECKPOINT_STEPS=500
EVAL_STEPS=500
WORKERS=4
SEED=20260901
VISION_ATTENTION=auto
# Reliable default for shared filesystems; set 0 only after a concurrent-load smoke.
SERIAL_MODEL_LOAD=1

WANDB_PROJECT=pixel-pivr
WANDB_NAME=pixel-pivr-large-scale-stage1
WANDB_RUN_ID=

# For a fresh Stage 2, set this to Stage 1 best.pt and choose a new OUTPUT_DIR.
INIT_ADAPTER=
