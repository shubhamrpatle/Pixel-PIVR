# Matched 16K/4K pixel-crop re-encoding experiment.
PYTHON_BIN=/absolute/path/to/venv/bin/python
MODEL_PATH=/absolute/path/to/LocateAnything-3B
EAGLE_ROOT=/absolute/path/to/Eagle/Embodied
DATA_ROOT=/absolute/path/to/workspace/root

# The preparation scripts live in the companion research workspace.
DATA_PREP_SCRIPT=/absolute/path/to/prepare_pivr_lora_4k.py
COMPACT_PREP_SCRIPT=/absolute/path/to/prepare_pivr_visual_context_ablation_4k.py
SOURCE_DATASET=/absolute/path/to/self_conditioned_point_witness_lora_4k_v1
ORIGINAL_DATASET=/absolute/path/to/causal_pointrelay_pbd_lora_4k_v1
CROP_DATASET=/absolute/path/to/pivr_lora_4k_crop380_exact_v1
CROP_MEDIA_ROOT=/absolute/path/to/pivr_lora_4k_crop380_exact_v1/media
PREPARED_DATASET=/absolute/path/to/pivr_pixel_crop_reencoded_380_4k_v1

TRAIN_DATA=/absolute/path/to/pivr_pixel_crop_reencoded_380_4k_v1/global_local/train.jsonl
VALIDATION_DATA=/absolute/path/to/pivr_pixel_crop_reencoded_380_4k_v1/global_local/validation.jsonl
HOLDOUT_HASHES=/absolute/path/to/all_benchmark_eval_image_sha256.txt
DATASET_AUDIT_REPORT=/absolute/path/to/pixel_crop_reencoded_380_dataset_audit.json
AUDIT_REPORT=/absolute/path/to/pixel_crop_reencoded_380_exact_loader_audit.json

OUTPUT_DIR=/absolute/path/to/output/pixel_crop_reencoded_380_native6000_lora4k
SMOKE_DIR=/absolute/path/to/output/pixel_crop_reencoded_380_native6000_smoke

# Use either 2 or 4 GPUs. GLOBAL_BATCH remains four in both cases.
GPU_IDS=0,1
GLOBAL_BATCH=4
MAX_STEPS=4000
ALLOWED_PADDING_RECORDS=0
EXPECTED_TRAIN_RECORDS=16000
EXPECTED_VALIDATION_RECORDS=1000
VALIDATION_RECORDS=1000
SMOKE_STEPS=3
SMOKE_VALIDATION_RECORDS=8
LORA_RANK=16

CROP_SIDE=380
IMAGE_TOKEN_LIMIT=6000
MAX_SEQUENCE=8192
VISUAL_CONTEXT=pixel_reencoded

LEARNING_RATE=1e-5
WARMUP_STEPS=100
CHECKPOINT_STEPS=500
EVAL_STEPS=500
WORKERS=2
SEED=20260902
VISION_ATTENTION=auto
SERIAL_MODEL_LOAD=1

WANDB_PROJECT=pivr-la
WANDB_NAME=pixel-crop-reencoded-380-native6000-16k
WANDB_RUN_ID=pixel-crop-reencoded-380-native6000-16k-seed20260902
INIT_ADAPTER=

# Frozen DOTAv2 Balanced-100 manifest: 100 images, 9,045 HBB GT, uncapped predictions.
EVAL_MANIFEST=/absolute/path/to/DOTAv2_balanced100.jsonl
EVAL_OUTPUT=/absolute/path/to/output/pixel_crop_reencoded_380_native6000_balanced100
EVAL_GPU_IDS=0,1
EVAL_WAVE_SIZE=200
