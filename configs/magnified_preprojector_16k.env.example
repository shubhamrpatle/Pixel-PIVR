# Matched 16K/4K single-encode magnified pre-projector PIVR.
PYTHON_BIN=/absolute/path/to/venv/bin/python
MODEL_PATH=/absolute/path/to/LocateAnything-3B
EAGLE_ROOT=/absolute/path/to/Eagle/Embodied
DATA_ROOT=/absolute/path/to/workspace/root
TRAIN_DATA=/absolute/path/to/pivr_cached_projected_roi_4k_v1/train.jsonl
VALIDATION_DATA=/absolute/path/to/pivr_cached_projected_roi_4k_v1/validation.jsonl
HOLDOUT_HASHES=/absolute/path/to/all_benchmark_eval_image_sha256.txt
OUTPUT_DIR=/absolute/path/to/output/pivr_preprojector_magnified_16k
SMOKE_DIR=/absolute/path/to/output/pivr_preprojector_magnified_smoke
AUDIT_REPORT=/absolute/path/to/output/pivr_preprojector_magnified_audit.json

GPU_IDS=0,1,2,3
GLOBAL_BATCH=4
MAX_STEPS=4000
ALLOWED_PADDING_RECORDS=0
EXPECTED_TRAIN_RECORDS=16000
EXPECTED_VALIDATION_RECORDS=1000
VALIDATION_RECORDS=1000
SMOKE_STEPS=3
LORA_RANK=16

# 6000 is the processor's pre-merge MoonViT patch budget for the global image.
IMAGE_TOKEN_LIMIT=6000
MAX_SEQUENCE=8192

# 380 px maps to the nearest 14 px MoonViT grid: 27x27 cells = 378 px.
# Overlapping 2x2 stride-1 groups yield 26x26 = 676 projected local tokens.
VISUAL_CONTEXT=preprojector_magnified_roi
MAGNIFIED_ROI_PIXELS=380
MAGNIFIED_ROI_STRIDE=1

LEARNING_RATE=1e-5
WARMUP_STEPS=100
CHECKPOINT_STEPS=500
EVAL_STEPS=500
WORKERS=2
SEED=20260901
VISION_ATTENTION=auto
SERIAL_MODEL_LOAD=1

# Leave blank to disable W&B.
WANDB_PROJECT=
WANDB_NAME=pivr-preprojector-magnified-16k
WANDB_RUN_ID=
INIT_ADAPTER=
